# Copy to .env for local runs. Never commit a real key.
# Test key for live smoke tests and the M0 gate (secrets manager in staging/prod).
BOLD_TEST_API_KEY=
# Key used by the stdio package (npx @billofladingdata/mcp).
BOLD_API_KEY=
# Partner API base URL. Defaults to https://tradedata.billofladingdata.com/partner-api
BOLD_API_BASE_URL=
# Upstream timeout in ms (brief: tool error after 25 s).
BOLD_API_TIMEOUT_MS=25000
LOG_LEVEL=info

# ---- HTTP server ----
# Public origin of this server (https in production). Used for OAuth metadata and the resource indicator.
BOLD_PUBLIC_URL=http://localhost:8080
PORT=8080
# Postgres and Redis (docker compose up -d postgres redis). Leave empty to use in-memory stand-ins.
DATABASE_URL=postgres://bold:bold@localhost:5432/bold
REDIS_URL=redis://localhost:6379
# Local KMS stand-in: 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOLD_LOCAL_KMS_KEY=
# Secrets shared by all instances (random strings, 32+ characters).
BOLD_CONFIRMATION_SECRET=
BOLD_CSRF_SECRET=
