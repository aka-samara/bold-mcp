{
  "title": "Bill of Lading Data MCP",
  "uid": "bold-mcp",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tool calls / min",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bold_tool_calls_total[5m]))*60"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bold_tool_calls_total{outcome=~\"tool_error|exception\"}[5m]))/clamp_min(sum(rate(bold_tool_calls_total[5m])),1e-9)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open sessions",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bold_active_sessions)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Connect success (1h)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(bold_connect_attempts_total{result=~\"success.*\"}[1h]))/clamp_min(sum(increase(bold_connect_attempts_total[1h])),1e-9)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tool calls by tool",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(bold_tool_calls_total[5m]))*60",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tool calls by outcome",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(bold_tool_calls_total[5m]))*60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Credits used by pool (per hour)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (rate(bold_credits_used_total[1h]))*3600",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Credits used by tool (per hour)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(bold_credits_used_total[1h]))*3600",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tool latency p50 / p95",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(bold_tool_call_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bold_tool_call_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "/token latency p95 and requests",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bold_token_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 (s)"
        },
        {
          "refId": "B",
          "expr": "sum by (grant, status) (rate(bold_token_requests_total[5m]))*60",
          "legendFormat": "{{grant}} {{status}} /min"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Connect page results",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(bold_connect_attempts_total[15m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Upstream rate-limit hits and key checks",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scope) (increase(bold_rate_limited_total[15m]))",
          "legendFormat": "limit {{scope}}"
        },
        {
          "refId": "B",
          "expr": "sum by (result) (increase(bold_key_validations_total[15m]))",
          "legendFormat": "key check {{result}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Unlocks and KMS errors",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (increase(bold_unlocks_total[1h]))",
          "legendFormat": "{{tool}}"
        },
        {
          "refId": "B",
          "expr": "sum(increase(bold_kms_errors_total[1h]))",
          "legendFormat": "KMS errors"
        }
      ]
    }
  ],
  "tags": [
    "bold-mcp"
  ]
}